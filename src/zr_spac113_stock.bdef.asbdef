managed implementation in class zbp_r_spac113_stock unique;
strict ( 2 );

define behavior for ZR_SPAC113_STOCK //alias <alias_name>
persistent table zspac113_stock
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  //field ( readonly ) WarehouseId, ProductId;
  //field ( readonly ) ProdName, ProdDescription, Street, ZipCode, City, Name;
  field ( mandatory : create, readonly : update ) WarehouseId, ProductId;

  mapping for zspac113_stock {
    WarehouseId = warehouse_id;
    ProductId = product_id;
    Amount = amount;
  }
}