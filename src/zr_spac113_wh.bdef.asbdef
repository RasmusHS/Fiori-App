managed implementation in class zbp_r_spac113_wh unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC113_WH alias Warehouse
persistent table zspac113_wh
draft table zspac113_wh_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) LocalCreatedBy, LocalCreatedAt, LocalLastChangedBy,
                     LocalLastChangedAt, LastChangedAt;
  field ( mandatory : create, readonly : update ) WarehouseId;
  field ( mandatory ) Street, ZipCode, City, WarehouseName;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zspac113_wh
  {
    WarehouseId = warehouse_id;
    Street = street;
    ZipCode = zip_code;
    City = city;
    WarehouseName = name;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}